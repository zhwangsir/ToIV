[Unit]
Description=ComfyUI on GPU0 (port 8196, alt for stuck 8189)
After=network.target

[Service]
Type=simple
User=merlin
WorkingDirectory=/opt/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=0
Environment=COMFYUI_PORT=8196
ExecStart=/opt/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8196 --output-directory /opt/ComfyUI/instances/gpu0/output --temp-directory /opt/ComfyUI/instances/gpu0/temp --input-directory /opt/ComfyUI/instances/gpu0/input --cache-lru 8
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
