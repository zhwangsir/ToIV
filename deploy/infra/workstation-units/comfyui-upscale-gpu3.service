[Unit]
Description=ComfyUI upscale-only worker on GPU3 (port 8263)
After=network.target

[Service]
Type=simple
User=merlin
WorkingDirectory=/opt/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=3
ExecStart=/opt/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8263 --output-directory /opt/ComfyUI/instances/gpu3/output --temp-directory /opt/ComfyUI/instances/gpu3/temp --input-directory /opt/ComfyUI/instances/gpu3/input --cache-lru 2 --disable-smart-memory
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
