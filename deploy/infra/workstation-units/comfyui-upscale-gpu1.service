[Unit]
Description=ComfyUI upscale-only worker on GPU1 (port 8261)
After=network.target

[Service]
Type=simple
User=merlin
WorkingDirectory=/opt/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/opt/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8261 --output-directory /opt/ComfyUI/instances/gpu1/output --temp-directory /opt/ComfyUI/instances/gpu1/temp --input-directory /opt/ComfyUI/instances/gpu1/input --cache-lru 2 --disable-smart-memory
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
