# 复制为 deploy/.env(不入库)
# 强随机:python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TOIV_JWT_SECRET=change-me-strong-random-secret
TOIV_ADMIN_EMAIL=admin
TOIV_ADMIN_PASSWORD=admin123
# 前端 API 基址:留空 = 相对路径(与 web 同源,经反代到 /api)
NEXT_PUBLIC_API_BASE=
# CORS 允许的前端来源(逗号分隔;allow_credentials=True 时禁止 "*",须精确域名)
# core 真机已默认包含 http://192.168.71.47:3100/3101;公网/额外域名在此追加
TOIV_CORS_ORIGINS=https://toiv.dgmt.top

# —— OpenTalking 数字人引擎 ——
# 本地 dev(兄弟目录运行 opentalking-unified): http://127.0.0.1:4403
# Docker 部署: http://opentalking:8000
# 真机未部署时显式设为 false,前端"数字人"页会显示降级提示
TOIV_OPENTALKING_ENABLED=true
TOIV_OPENTALKING_BASE_URL=http://127.0.0.1:4403

# —— SoulX LiveAct 全身数字人生成引擎(workstation 真机) ——
# 空 = 未部署;生成时长 = 配音时长,分镜需先完成配音
TOIV_LIVEACT_BASE_URL=http://192.168.71.127:9400

# 向量 RAG 嵌入(2026-07-28 设备说明:workstation 真机 :9302, Qwen3-Embedding-4B, GPU1)
TOIV_EMBED_BASE_URL=http://192.168.71.127:9302/v1
TOIV_EMBED_MODEL=Qwen3-Embedding-4B

# R18 专用 LTX-2.3 + 10Eros（SFW 默认不是这条；SFW LTX-2.5 已退役）
# ComfyUI worker 实际文件名;留空使用代码默认值
# 2026-07-28 实测 worker 上 VAE 文件名为 LTX23_video_vae_bf16.safetensors,非 ltx_vae
TOIV_LTX_UNET=10eros_v14.safetensors
TOIV_LTX_GEMMA=gemma3_12b_it_bf16/model.safetensors
TOIV_LTX_VAE=LTX23_video_vae_bf16.safetensors

# Redis(限流/画布事件/worker 健康缓存共享状态,2026-08-04 接入)
# core 本机 Redis 仅监听 127.0.0.1 无密码;不可达时自动降级进程内存,请求不报错
TOIV_REDIS_URL=redis://127.0.0.1:6379/0

# MiniMax H3（海螺 3.0）视频生成引擎:专用 ComfyUI ≥ 0.30 实例(workstation :8195,systemd 托管)
# 独立于 ComfyUI-LB 集群;实例下线时 /api/h3/* 返回 503,引擎注册表自动标不可用
# 设 false 可彻底关闭 H3 入口(前端不展示、后端 /api/h3/* 与 /api/models/engines 均 503/不可用)
TOIV_H3_ENABLED=true
TOIV_H3_BASE_URL=http://192.168.71.127:8195

# 音频产物根目录(人声分离等独立音频工具产物,POST /api/audio/separate)
# core 指向 NAS 挂载点;留空 = 本地候选目录。NAS 不可达/不可写时自动降级本地回退,不 500
TOIV_AUDIO_DIR=/mnt/toiv-nas/toiv/outputs/audio
