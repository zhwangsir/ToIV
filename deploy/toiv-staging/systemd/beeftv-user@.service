[Unit]
Description=BeefTV per-user staging backend for ToIV user %i (started by the beeftv-web login gate)
After=network-online.target
[Service]
WorkingDirectory=/home/merlin/beeftv-staging/users/%i
EnvironmentFile=/home/merlin/beeftv-staging/users/%i/backend.env
ExecStart=/home/merlin/beeftv-staging/beeftv-server
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/merlin/beeftv-staging/users/%i/backend.log
StandardError=append:/home/merlin/beeftv-staging/users/%i/backend.log
