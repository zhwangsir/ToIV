# ToIV API 配置（复制为 .env 后按需修改；.env 不入库）
# 逗号分隔的 ComfyUI worker 列表。生产入口 = ComfyUI-LB :8188（亦可直连 image-gate :8196）。
# :8189 已退役，勿再写入默认。多 worker 例：
#   TOIV_COMFY_WORKERS=http://192.168.71.127:8188,http://192.168.71.127:8196
TOIV_COMFY_WORKERS=http://192.168.71.127:8188
TOIV_DEFAULT_CKPT=flux2_dev_fp8mixed.safetensors
TOIV_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# 鉴权：生产务必设置一个高强度随机值
TOIV_JWT_SECRET=change-me-to-a-random-32+-byte-secret
# Scoped service tokens (POST /api/auth/service-token): non-admin accounts allowed to mint them
# (comma separated; empty = endpoint off). Used by canvas-api's H3 credential refresh.
TOIV_SERVICE_ACCOUNTS=
TOIV_SERVICE_TOKEN_EXPIRE_MINUTES=10080
# Token revocation list (sha256 fingerprints / per-user cut-off), hot-reloaded; see scripts/revoke_token.py
TOIV_REVOKED_TOKENS_FILE=

# 可信反向代理网段(逗号分隔 CIDR 或单 IP):仅当请求直连对端属于该清单时,
# 登录限流才采纳 X-Forwarded-For 首跳作为真实客户端 IP。默认空 = 不信任任何
# XFF(防伪造 XFF 换 IP 绕过限流)。生产 core 前置 OpenResty/frp 反代,需把反代
# 出口 IP 配进来(同机回环 127.0.0.1,::1 或 LAN 反代 IP),否则限流主体退化为
# 反代 IP(同反代后所有用户共享配额)。
TOIV_TRUSTED_PROXY_IPS=

# C1b 参考 URL 安全:公网 http(s) 参考图/参考音默认拒绝私网/环回/链路本地/保留
# 地址与 URL userinfo(见 app/services/ref_guard.py)。此处逗号分隔的主机名白名单
# 可放行内网参考下载目标;默认空 = 无例外,不新造全局私网放行。
TOIV_REF_FETCH_ALLOWED_HOSTS=

# 启动时引导管理员账号（账号为用户名,不强制邮箱;二者皆非空则同步该 admin)
# 不开放自助注册,其余账号由管理员在后台发放
TOIV_ADMIN_EMAIL=admin
TOIV_ADMIN_PASSWORD=change-me-in-local-dotenv

# 微信小程序登录(POST /api/auth/wechat)。AppSecret 仅服务端持有,不入仓库。
# 二者皆空且 bypass 关 = 微信登录 503;TOIV_WECHAT_DEV_BYPASS=true 为开发过渡
# (不调腾讯 code2session,code 直接映射 dev-{code} openid),生产必须 false。
TOIV_WECHAT_APPID=
TOIV_WECHAT_SECRET=
TOIV_WECHAT_DEV_BYPASS=false
 # 多语言 TTS 服务地址（日语/韩语/粤语等）。空 = 未部署。
 TOIV_TTS_MULTILINGUAL_URL=

# Sentry 错误追踪 DSN（空 = 不启用；生产填真实 DSN 后自动上报异常 + 10% 性能采样）
TOIV_SENTRY_DSN=
# 运行环境（传给 Sentry：development / production）
TOIV_ENVIRONMENT=development
# 是否暴露 API 文档(/docs /redoc /openapi.json)。默认 false:生产暴露完整 schema 等于
# 公开攻击面地图(QA-FULL-2026-08-11 P2);本地开发需要 Swagger UI 时置 true。
TOIV_EXPOSE_API_DOCS=false

# 视频质量评估 VLM = ep.vlm.primary workstation :9311 served=toiv-vlm
# (weight.qwen3vl.8b-instruct)。禁止指向 spark01:8000(现为 DSv4 TP headless)。
# 启用后:视频作业完成时异步调 VLM；失败/超时降级不阻塞主流程。
# VLM 不可达时把 TOIV_VIDEO_SCORER_ENABLED=false 灰度回退。
TOIV_VLM_SERVER_URL=http://192.168.71.127:9311
TOIV_VLM_MODEL_ID=toiv-vlm
TOIV_VIDEO_SCORER_ENABLED=true

# 自愈闭环 LLM 修复器(2026-09-15):烟测失败时 DSv4 提议图补丁,沙箱校验+试提交,
# 通过自动固化(原始图备份可还原)。置 false 关闭(仅确定性修复器)。
TOIV_SELFHEAL_LLM_ENABLED=true

# LLM 大脑(ep.llm.primary spark02:8000 · weight.dsv4.flash-dspark-ablit)。
# 规范 model id = deepseek-v4-flash-dspark；DISPLAY 须诚实，禁止谎称 Qwen/GLM。
TOIV_LLM_BASE_URL=http://192.168.71.84:8888/v1
TOIV_LLM_MODEL=DeepSeek-V4.1-Flash-1017
TOIV_LLM_DISPLAY_NAME=DeepSeek-V4.1-Flash-1017 (Mia TensorFold TP2 :8888)
# OpenAI 兼容 LLM 代理 /api/llm/v1 白名单（逗号分隔，第一个=canonical 默认）。
# qwen*/glm* = live vLLM 仍在 serve 的 DEPRECATED 兼容别名(同 DSv4 权重)；清 served 后删除。
TOIV_LLM_PROXY_MODELS=DeepSeek-V4.1-Flash-1017,deepseek-v4-flash-dspark
TOIV_VIDEO_SCORER_THRESHOLD=0.65

# B 评测管线 VLM 评分器 → ep.vlm.primary :9311 toiv-vlm(非 spark01)。
# 空 base = auto 档退启发式;不可达时逐变体降级启发式,不炸链路。
TOIV_EVAL_VLM_BASE_URL=http://192.168.71.127:9311/v1
TOIV_EVAL_VLM_MODEL=toiv-vlm
TOIV_EVAL_VLM_TIMEOUT=60

# 向量 RAG 嵌入(2026-07-28 设备说明:workstation 真机 :9302, Qwen3-Embedding-4B, GPU1)
TOIV_EMBED_BASE_URL=http://192.168.71.127:9302/v1
TOIV_EMBED_MODEL=Qwen3-Embedding-4B

# 短剧工作室剧本拆解默认 LLM 层(L1/L2/L3/L4)。
# L2/L3/L4 均路由 spark02 deepseek-v4-flash-dspark(S4a 后不再依赖 EXO)。
# 生产 core 已升 L3(拆解+润色);L1 仅作 spark02 故障时回退。
TOIV_DRAMA_STORYBOARD_LAYER=L3
TOIV_DRAMA_POLISH_LAYER=L3

# Redis(限流/画布事件/worker 健康缓存共享状态,2026-08-04 接入)。
# 生产 core 与 toiv-api 同机,仅监听 127.0.0.1 无密码;不可达时自动降级进程内存,
# 请求不报错(见 app/services/redis_client.py)。开发机无 Redis 也无需改动。
TOIV_REDIS_URL=redis://127.0.0.1:6379/0

# 画布(ComfyUI)同源反向代理目标(GET/POST /api/canvas/proxy,2026-08-30 画布公网
# 混合内容根治):公网 HTTPS 下前端 iframe 改走同源代理而非直连 http://IP:8188。
# SSRF 防线:目标仅取本配置,路由不接受请求传入地址。
TOIV_CANVAS_COMFY_URL=http://192.168.71.127:8188

# MiniMax H3（海螺 3.0）视频生成引擎:专用 ComfyUI ≥ 0.30 实例(workstation :8264 生产口,
# systemd=toiv-comfyui-h3-gpu1;权重经 extra_model_paths 挂 NAS h3/),独立于 ComfyUI-LB。
# :8195 已 stop+disable,仅评测/溢出白名单(legacy),勿再作默认生产口。
# 实例下线时 /api/h3/* 返回 503,引擎注册表自动标不可用。
TOIV_H3_BASE_URL=http://192.168.71.127:8264
# H3 双 worker 池(2026-09-13):逗号分隔多实例,提交按 queue 最短 least-loaded 调度;
# 未就绪实例探测失败自动跳过(零报错)。留空 = 单实例回落上一行,零改动兼容。
# TOIV_H3_BASE_URLS=http://192.168.71.127:8264,http://192.168.71.116:8198

# 视频超分 fleet(M6):workstation GPU1/2/3 超分专用 ComfyUI 实例,逗号分隔。
# 仅跑 4x-UltraSharp 帧超分(--cache-lru 2),不入 ComfyUI-LB/WorkerPool;
# 至少 1 个实例可达才能提交 POST /api/video/upscale(全挂 503)。
# :8261 已撤；live upscale=:8262/:8263
TOIV_UPSCALE_WORKERS=http://192.168.71.127:8262,http://192.168.71.127:8263

# 音频产物根目录(人声分离等独立音频工具产物,POST /api/audio/separate)。
# 生产 core 指向 NAS 挂载点 /mnt/toiv-nas/toiv/outputs/audio;留空 = 本地候选目录。
# NAS 不可达/不可写时自动降级本地回退目录并记 warning,不 500(见 app/storage.audio_output_root)。
TOIV_AUDIO_DIR=

# D0 渲染成本预估:默认空=未定价(无虚构金额),0=不启用金钱预算。
# 运维按真实合同配置 JSON:currency 为三位大写币种;rates 键为
# engine:render_mode:pipeline(亦支持 engine:render_mode),组成可用 pixel_frame/candidate,
# 数值必须为有限非负十进制字符串。例仅示结构,不包含任何默认价格。
# TOIV_STUDIO_COST_RATES_JSON={"currency":"CNY","rates":{"h3:video:ref2va":{"pixel_frame":"..."},"h3:image_motion:ref2va":{"candidate":"..."}}}
TOIV_STUDIO_COST_RATES_JSON=
TOIV_STUDIO_RENDER_BUDGET_LIMIT=0
