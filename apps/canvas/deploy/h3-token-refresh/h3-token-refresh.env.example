# /home/merlin/beeftv-prod/h3-token-refresh/h3-token-refresh.env  (chmod 600; no secrets in here)
TOIV_API=http://127.0.0.1:8090
CANVAS_API=http://127.0.0.1:8290
# Identity for canvas-api: the same BEEFTV_GATE_UID / BEEFTV_GATE_KEY_FILE canvas-api-pg itself uses.
CANVAS_ENV_FILE=/home/merlin/beeftv-prod/canvas-api/canvas-api.env
# Service account (chmod 600): TOIV_H3_EMAIL=svc_canvas_h3 / TOIV_H3_PASSWORD=...  (non-admin, in TOIV_SERVICE_ACCOUNTS)
H3_CRED_FILE=/home/merlin/beeftv-prod/secrets/h3_service_account.env
# Scoped service token (default). TOKEN_MODE=login = legacy full session token (warns).
TOKEN_MODE=service
# 1 = also refresh the assistant's toiv-llm channel with an llm-scoped token.
SYNC_LLM_CHANNEL=0
# sha256 fingerprints of replaced credentials (for apps/api/scripts/revoke_token.py --sha256).
RETIRED_FILE=/home/merlin/beeftv-prod/h3-token-refresh/retired.sha256
WARN_HOURS=48
REFRESH_ATTEMPTS=4
RETRY_BASE_SECONDS=30
STATUS_FILE=/home/merlin/beeftv-prod/h3-token-refresh/status.json
