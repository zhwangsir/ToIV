[Unit]
Description=BeefTV staging backend (127.0.0.1:8272)
After=network-online.target
[Service]
WorkingDirectory=/home/merlin/beeftv-staging
EnvironmentFile=/home/merlin/beeftv-staging/backend.env
ExecStart=/home/merlin/beeftv-staging/beeftv-server
Restart=always
RestartSec=3
StandardOutput=append:/home/merlin/beeftv-staging/logs/backend.log
StandardError=append:/home/merlin/beeftv-staging/logs/backend.log
[Install]
WantedBy=default.target
